{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTC Balance Checker",
  "version": "2.0.0",
  "identifier": "com.jonacarbi.btcbalancechecker",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BTC Balance Checker",
        "width": 1080,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Finance",
    "shortDescription": "Watch Bitcoin addresses and get alerted when funds appear",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
